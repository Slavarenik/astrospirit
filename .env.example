# Google Cloud Translation API key (Translation API enabled on the project).
# Restrict the key to Cloud Translation API only.
# DEV-ONLY FALLBACK: used directly from the client until Firebase below is
# configured and functions/ is deployed, at which point the app automatically
# routes translation through the `translateProxy` Cloud Function instead and
# this key is never bundled into the app. See functions/README.md.
EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY=

# Firebase web config — from Firebase Console → Project settings → Your apps
# → Web app → SDK setup and configuration → Config. These are public client
# identifiers, not secrets (Firestore/Auth access is enforced by
# firestore.rules + Auth, not by hiding these values).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In — the "Web client ID" Firebase auto-creates once you enable
# the Google provider under Authentication → Sign-in method → Google → Web
# SDK configuration. This is NOT the iOS CLIENT_ID in GoogleService-Info.plist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat — Project settings → API keys → "Public app-specific API keys"
# (one per platform you've added as an app in the RevenueCat project). These
# are public SDK keys, safe to ship in the client — same as the Firebase
# config above. Required for purchases; without them the Paywall cannot
# unlock Premium (no local/dev stub).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
